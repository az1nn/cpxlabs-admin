generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  company   String
  status    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([status])
  @@map("customers")
}
