generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum CustomerStatus {
  lead
  active
  inactive

  @@map("customer_status")
}

enum OpportunityStage {
  qualification
  discovery
  proposal
  negotiation
  won
  lost

  @@map("opportunity_stage")
}

enum ApplicationRole {
  admin
  manager
  viewer

  @@map("application_role")
}

enum AccessStatus {
  active
  disabled

  @@map("access_status")
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  email     String         @unique
  company   String
  status    CustomerStatus
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([name])
  @@index([status])
  @@map("customers")
}

model Opportunity {
  id                String           @id @default(cuid())
  name              String
  accountName       String           @map("account_name")
  amountMinor       BigInt           @map("amount_minor")
  currency          String           @db.Char(3)
  expectedCloseDate DateTime         @db.Date @map("expected_close_date")
  stage             OpportunityStage @default(qualification)
  version           Int              @default(1)
  lossReason        String?          @map("loss_reason")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([stage])
  @@index([expectedCloseDate])
  @@index([updatedAt])
  @@index([accountName])
  @@map("opportunities")
}

model AuditEvent {
  id            String   @id @default(cuid())
  actorId       String   @map("actor_id")
  actorEmail    String   @map("actor_email")
  actorName     String   @map("actor_name")
  action        String
  subjectType   String   @map("subject_type")
  subjectId     String   @map("subject_id")
  before        Json?
  after         Json?
  correlationId String   @map("correlation_id")
  tenantId      String?  @map("tenant_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([occurredAt, id])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
  @@index([correlationId])
  @@map("audit_events")
}

model AccessProfile {
  id        String          @id @default(cuid())
  userId    String          @unique @map("user_id")
  role      ApplicationRole
  status    AccessStatus    @default(active)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([role])
  @@index([status])
  @@map("access_profiles")
}
